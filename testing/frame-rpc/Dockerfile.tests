FROM node:22-bookworm-slim
WORKDIR /tests
COPY package*.json ./
RUN npm ci --omit=dev
# Schema snapshot from ethereum/execution-apis#907.
ADD https://github.com/ethereum/execution-apis/archive/94b90a4855233838b75ff54fc363b54f700f653e.tar.gz /tmp/schemas.tar.gz
RUN mkdir /spec && tar -xzf /tmp/schemas.tar.gz -C /spec --strip-components=1 && rm /tmp/schemas.tar.gz
COPY test.mjs ./
ENV SCHEMA_DIR=/spec/src/schemas
CMD ["npm", "test"]
