@@ -0,0 +1,293 @@
+//! Diagnose the supported MDBX_USE_MINCORE compile option with prefault-enabled WRITEMAP.
+//! Fixtures, input allocation, exact snapshot checks, and file-local cache eviction are untimed.
+//! MPT_MINCORE_SAMPLES controls measured rounds after four warmups; MPT_MINCORE_FILTER selects
+//! cases.
+
+#[path = "../tests/persistence_support/mod.rs"]
+mod persistence_support;
+
+use alloy_primitives::B256;
+use persistence_support::{node, path, snapshot};
+use reth_db::{
+    mdbx::{ffi, DatabaseArguments, SyncMode},
+    DatabaseEnv, DatabaseEnvKind,
+};
+use reth_db_api::{
+    cursor::{DbCursorRO, DbCursorRW},
+    transaction::{DbTx, DbTxMut},
+    Database,
+};
+use reth_trie::{updates::StorageTrieUpdatesSorted, BranchNodeCompact, Nibbles};
+use reth_trie_db::{DatabaseStorageTrieCursor, PackedKeyAdapter, TrieTableAdapter};
+use std::{collections::BTreeMap, path::Path, time::Instant};
+
+type Adapter = PackedKeyAdapter;
+type Accounts = <Adapter as TrieTableAdapter>::AccountTrieTable;
+type Storages = <Adapter as TrieTableAdapter>::StorageTrieTable;
+
+fn open(path: &Path) -> DatabaseEnv {
+    let mut db = DatabaseEnv::open(
+        path,
+        DatabaseEnvKind::RW,
+        DatabaseArguments::test()
+            .with_geometry_max_size(Some(512 * 1024 * 1024))
+            .with_sync_mode(Some(SyncMode::Durable)),
+    )
+    .unwrap();
+    db.with_raw_env_ptr(|env| {
+        let mut flags = 0;
+        // SAFETY: Both pointers remain valid during this call.
+        assert_eq!(unsafe { ffi::mdbx_env_get_flags(env, &raw mut flags) }, 0);
+        assert_eq!(flags & ffi::MDBX_LIFORECLAIM, 0);
+        assert_ne!(flags & ffi::MDBX_NORDAHEAD, 0);
+        assert_eq!(flags & (ffi::MDBX_SAFE_NOSYNC | ffi::MDBX_NOMETASYNC), 0);
+        let mut prefault = 0;
+        // SAFETY: The environment and output pointers remain valid throughout the call.
+        assert_eq!(
+            unsafe {
+                ffi::mdbx_env_get_option(
+                    env,
+                    ffi::MDBX_opt_prefault_write_enable,
+                    &raw mut prefault,
+                )
+            },
+            0
+        );
+        assert_eq!(prefault, 1);
+        assert_ne!(flags & ffi::MDBX_WRITEMAP, 0);
+    });
+    db.create_tables().unwrap();
+    db
+}
+
+fn address(index: u32) -> B256 {
+    let mut value = B256::ZERO;
+    value[..4].copy_from_slice(&index.to_be_bytes());
+    value
+}
+
+fn accounts(db: &DatabaseEnv) -> BTreeMap<Nibbles, BranchNodeCompact> {
+    db.tx()
+        .unwrap()
+        .cursor_read::<Accounts>()
+        .unwrap()
+        .walk(None)
+        .unwrap()
+        .map(|row| {
+            let (key, node) = row.unwrap();
+            (key.0, node)
+        })
+        .collect()
+}
+
+struct Updates {
+    accounts: Vec<(Nibbles, BranchNodeCompact)>,
+    storages: Vec<(B256, StorageTrieUpdatesSorted)>,
+}
+
+fn updates(round: u32, large: bool, initial: bool) -> Updates {
+    let account_count = if large { 32768 } else { 1024 };
+    let stride = if initial { 1 } else { 8 };
+    let accounts = (0..account_count)
+        .step_by(stride)
+        .map(|index| (path(index), node(u64::from(index) + (u64::from(round) << 32), 8)))
+        .collect();
+    let addresses = if large { 128 } else { 1 };
+    let storages = (0..addresses)
+        .map(|account| {
+            (
+                address(account),
+                StorageTrieUpdatesSorted {
+                    storage_nodes: (0..512)
+                        .step_by(stride)
+                        .map(|index| {
+                            (
+                                path(index),
+                                Some(node(u64::from(index) + (u64::from(round) << 32), 8)),
+                            )
+                        })
+                        .collect(),
+                },
+            )
+        })
+        .collect();
+    Updates { accounts, storages }
+}
+
+fn write(db: &DatabaseEnv, updates: &Updates) -> (u128, u128) {
+    let started = Instant::now();
+    let tx = db.tx_mut().unwrap();
+    let mut cursor = tx.cursor_write::<Accounts>().unwrap();
+    for (path, node) in &updates.accounts {
+        cursor.upsert((*path).into(), node).unwrap();
+    }
+    drop(cursor);
+    for (account, updates) in &updates.storages {
+        DatabaseStorageTrieCursor::<_, Adapter>::new(
+            tx.cursor_dup_write::<Storages>().unwrap(),
+            *account,
+        )
+        .write_storage_trie_updates_sorted(updates)
+        .unwrap();
+    }
+    let write_ns = started.elapsed().as_nanos();
+    let started = Instant::now();
+    tx.commit().unwrap();
+    (write_ns, started.elapsed().as_nanos())
+}
+
+#[cfg(target_os = "linux")]
+fn file_residency(path: &Path, evict: bool) -> (i64, i64) {
+    let output = std::process::Command::new("python3")
+        .args([
+            "-c",
+            r#"
+import ctypes,mmap,os,sys
+f=os.open(sys.argv[1],os.O_RDONLY)
+if sys.argv[2]=='true': os.posix_fadvise(f,0,0,os.POSIX_FADV_DONTNEED)
+size=os.fstat(f).st_size
+mapping=mmap.mmap(f,size,access=mmap.ACCESS_COPY)
+pages=(size+mmap.PAGESIZE-1)//mmap.PAGESIZE
+vector=(ctypes.c_ubyte*pages)()
+libc=ctypes.CDLL(None,use_errno=True)
+libc.mincore.argtypes=[ctypes.c_void_p,ctypes.c_size_t,ctypes.POINTER(ctypes.c_ubyte)]
+rc=libc.mincore(ctypes.addressof(ctypes.c_char.from_buffer(mapping)),size,vector)
+assert rc==0,ctypes.get_errno()
+print(sum(x&1 for x in vector),pages)
+mapping.close()
+os.close(f)
+"#,
+        ])
+        .arg(path.join("mdbx.dat"))
+        .arg(evict.to_string())
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+    let values = String::from_utf8(output.stdout).unwrap();
+    let mut values = values.split_whitespace().map(|v| v.parse().unwrap());
+    (values.next().unwrap(), values.next().unwrap())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn file_residency(_: &Path, _: bool) -> (i64, i64) {
+    panic!("file-local cold-cache benchmark requires Linux");
+}
+
+#[cfg(target_os = "linux")]
+fn page_faults() -> (u64, u64) {
+    let stat = std::fs::read_to_string("/proc/self/stat").unwrap();
+    let fields = stat.rsplit_once(')').unwrap().1.split_whitespace().collect::<Vec<_>>();
+    (fields[7].parse().unwrap(), fields[9].parse().unwrap())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn page_faults() -> (u64, u64) {
+    (0, 0)
+}
+
+fn apply_expected(
+    updates: &Updates,
+    account_nodes: &mut BTreeMap<Nibbles, BranchNodeCompact>,
+    storage_nodes: &mut BTreeMap<(B256, Nibbles), BranchNodeCompact>,
+) {
+    account_nodes.extend(updates.accounts.iter().cloned());
+    for (address, updates) in &updates.storages {
+        for (path, node) in &updates.storage_nodes {
+            storage_nodes.insert((*address, *path), node.clone().unwrap());
+        }
+    }
+}
+
+fn run(case: &str, samples: u32, mincore: u8) {
+    let dir = tempfile::tempdir().unwrap();
+    let initial = updates(0, true, true);
+    let mut expected_accounts = BTreeMap::new();
+    let mut expected_storage = BTreeMap::new();
+    apply_expected(&initial, &mut expected_accounts, &mut expected_storage);
+    write(&open(dir.path()), &initial);
+    let environment = (case == "warm_open").then(|| open(dir.path()));
+    for round in 1..=samples + 4 {
+        let updates = updates(round, true, false);
+        apply_expected(&updates, &mut expected_accounts, &mut expected_storage);
+        let (resident, pages) = if case == "cold" {
+            let status = file_residency(dir.path(), true);
+            assert!(
+                status.0 * 1000 <= status.1,
+                "cold fixture has more than 0.1% resident pages: {status:?}"
+            );
+            status
+        } else {
+            (-1, -1)
+        };
+        let opened = environment.is_none().then(|| open(dir.path()));
+        let db = opened.as_ref().or(environment.as_ref()).unwrap();
+        let before = db.info().unwrap().page_ops();
+        let faults_before = page_faults();
+        let start = Instant::now();
+        let (write_ns, commit_ns) = write(db, &updates);
+        let elapsed = start.elapsed().as_nanos();
+        let faults_after = page_faults();
+        let info = db.info().unwrap();
+        let after = info.page_ops();
+        let mincore_calls = after.mincore - before.mincore;
+        if mincore == 0 {
+            assert_eq!(mincore_calls, 0);
+        }
+        let minor_faults = faults_after.0 - faults_before.0;
+        let major_faults = faults_after.1 - faults_before.1;
+        let last_page = info.last_pgno();
+        let (actual_storage, actual_accounts) = if environment.is_some() {
+            (snapshot::<Adapter>(&db.tx().unwrap()), accounts(db))
+        } else {
+            drop(opened);
+            let reopened = open(dir.path());
+            (snapshot::<Adapter>(&reopened.tx().unwrap()), accounts(&reopened))
+        };
+        assert_eq!(actual_storage, expected_storage);
+        assert_eq!(actual_accounts, expected_accounts);
+        if round > 4 {
+            println!(
+                "{case},{mincore},{},{elapsed},{write_ns},{commit_ns},{mincore_calls},{},{minor_faults},{major_faults},{resident},{pages},{},{},{},{},{},{last_page}",
+                round - 4,
+                after.prefault - before.prefault,
+                after.newly - before.newly,
+                after.cow - before.cow,
+                after.wops - before.wops,
+                after.msync - before.msync,
+                after.fsync - before.fsync
+            );
+        }
+    }
+    drop(environment);
+    let db = open(dir.path());
+    let tx = db.tx_mut().unwrap();
+    tx.cursor_write::<Accounts>().unwrap().upsert(path(0).into(), &node(u64::MAX, 8)).unwrap();
+    drop(tx);
+    drop(db);
+    let reopened = open(dir.path());
+    assert_eq!(snapshot::<Adapter>(&reopened.tx().unwrap()), expected_storage);
+    assert_eq!(accounts(&reopened), expected_accounts);
+}
+
+fn main() {
+    // SAFETY: MDBX exposes immutable build information as static, NUL-terminated strings.
+    let build_options =
+        unsafe { std::ffi::CStr::from_ptr(ffi::mdbx_build.options) }.to_str().unwrap();
+    eprintln!("MDBX_BUILD_OPTIONS={build_options}");
+    let mincore = if build_options.contains("MDBX_USE_MINCORE=0 ") {
+        0
+    } else {
+        assert!(build_options.contains("MDBX_USE_MINCORE=1 "));
+        1
+    };
+    let samples =
+        std::env::var("MPT_MINCORE_SAMPLES").map(|v| v.parse::<u32>().unwrap()).unwrap_or(12);
+    let filter = std::env::var("MPT_MINCORE_FILTER").unwrap_or_default();
+    assert!(samples > 0);
+    println!("case,mincore,sample,durable_ns,write_ns,commit_ns,mincore_calls,prefault_writes,minor_faults,major_faults,resident_pages_before,total_pages,new_pages,cow_pages,write_ops,msync_calls,fsync_calls,last_page");
+    for case in ["warm", "warm_open", "cold"] {
+        if case.contains(&filter) {
+            run(case, samples, mincore);
+        }
+    }
+}
